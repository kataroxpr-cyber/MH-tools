<Window x:Class="MH4UModern.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in MH4U Modern"
        Width="680" Height="590" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="16,16,0,0" Padding="20,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#20352F">
                            <TextBlock Text="MH" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="What's new" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="A quick look at what changed since your last build." Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource AccentChipStyle}" VerticalAlignment="Center"><TextBlock x:Name="VersionText" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="20,16,20,10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChangesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FieldCardStyle}" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentTintBrush}" VerticalAlignment="Top" Margin="0,1,0,0"><TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Shown once for each new MH4U Modern version." Style="{StaticResource MutedTextStyle}" FontSize="10" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Continue" Style="{StaticResource AccentButtonStyle}" Padding="22,8" Click="Continue_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
