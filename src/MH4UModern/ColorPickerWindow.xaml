<Window x:Class="MH4UModern.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color"
        Width="820" Height="545"
        MinWidth="720" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PickerTitle" Text="Pick Color" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a preset or click anywhere in the spectrum. MH4U Modern converts it to the save's RGB bytes automatically."
                           Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Width="38" Height="38" Padding="0" Click="Cancel_Click" ToolTip="Cancel"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Quick colors" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Tap any swatch to use it as a starting point."
                               Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PalettePanel" Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Spectrum" Style="{StaticResource SectionTitleStyle}" Margin="0"/>

                    <Grid Grid.Row="2" x:Name="SpectrumGrid" MinHeight="270" ClipToBounds="True">
                        <Border x:Name="SpectrumBase" Background="#FFFF0000" CornerRadius="7"/>
                        <Rectangle RadiusX="7" RadiusY="7" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="7" RadiusY="7" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas x:Name="SpectrumCanvas" Background="#01000000"
                                MouseLeftButtonDown="Spectrum_MouseLeftButtonDown"
                                MouseLeftButtonUp="Spectrum_MouseLeftButtonUp"
                                MouseMove="Spectrum_MouseMove"
                                SizeChanged="PickerSurface_SizeChanged">
                            <Ellipse x:Name="SpectrumMarker" Width="18" Height="18" Fill="#01000000"
                                     Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.85"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Hue" Style="{StaticResource CompactFieldLabelStyle}"/>
                    <Grid Grid.Row="6" Height="24" ClipToBounds="True">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0"/>
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="HueCanvas" Background="#01000000"
                                MouseLeftButtonDown="Hue_MouseLeftButtonDown"
                                MouseLeftButtonUp="Hue_MouseLeftButtonUp"
                                MouseMove="Hue_MouseMove"
                                SizeChanged="PickerSurface_SizeChanged">
                            <Border x:Name="HueMarker" Width="6" Height="24" CornerRadius="2"
                                    Background="White" BorderBrush="#A0000000" BorderThickness="1"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SelectedPreview" Width="56" Height="42" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="HexText" FontWeight="SemiBold"/>
                <TextBlock x:Name="RgbText" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
            </StackPanel>
            <Button Grid.Column="3" Content="Cancel" Width="92" Click="Cancel_Click"/>
            <Button Grid.Column="5" Content="Apply" Width="102" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>
