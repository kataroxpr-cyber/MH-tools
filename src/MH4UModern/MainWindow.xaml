                                    <ToolTip>
                                        <StackPanel MinWidth="190">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Type}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"><Run Text="Slot "/><Run Text="{Binding Slot, Mode=OneWay}"/><Run Text="   ·   "/><Run Text="{Binding RarityText, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding CatalogStats}" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="330" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Grid.ToolTip>
                                <Image Source="{Binding Image}" Margin="3" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
