                        <Border Grid.Column="1" Style="{StaticResource ChipStyle}" VerticalAlignment="Center"><TextBlock Text="HD Remix UI" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                    </Grid>

                    <Grid Grid.Row="2">
