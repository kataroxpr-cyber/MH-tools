                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBox x:Name="ItemSearchBox" Style="{StaticResource SearchBoxStyle}" TextChanged="ItemSearchBox_TextChanged" PreviewKeyDown="ItemSearchBox_PreviewKeyDown" ToolTip="Search the items currently stored in this save"/>
