                                </Grid>
                                <ListBox x:Name="EquipmentGrid" Grid.Row="1" ItemsSource="{Binding EquipmentPageSlots}" SelectionMode="Single" Style="{StaticResource InventoryGridListBoxStyle}" ItemContainerStyle="{StaticResource SlotListBoxItemStyle}" ItemTemplate="{StaticResource EquipmentSlotTemplate}" SelectionChanged="EquipmentGrid_SelectionChanged" PreviewMouseLeftButtonDown="EquipmentGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="EquipmentGrid_PreviewMouseMove" AllowDrop="True" DragOver="EquipmentGrid_DragOver" Drop="EquipmentGrid_Drop"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="10" Columns="10"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                            </Grid>
