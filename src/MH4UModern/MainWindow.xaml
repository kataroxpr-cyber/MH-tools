                                <Image Source="{Binding IconImage}" Width="24" Height="24" MaxWidth="24" MaxHeight="24" Margin="11" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
