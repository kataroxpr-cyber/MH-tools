<Window x:Class="MH4UModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MH4UModern.ViewModels"
        xmlns:views="clr-namespace:MH4UModern.Views"
        mc:Ignorable="d"
        Title="MH4U Modern"
        Width="1320" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top command bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#20352F" Margin="0,0,12,0">
                        <TextBlock Text="MH" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MH4U Modern" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Save Editor · v0.18.0" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActiveHunterName" Text="{Binding HunterIdentity.DisplayName, TargetNullValue='No character selected', FallbackValue='No character selected'}"
                               FontWeight="SemiBold" FontSize="16" MaxWidth="220" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding HunterIdentity.DisplayName}"/>
                    <TextBlock Grid.Column="1" Text="{Binding HunterIdentity.GenderSymbol}" ToolTip="{Binding HunterIdentity.GenderLabel}"
                               FontFamily="Segoe UI Symbol" FontSize="21" Width="28" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding HunterIdentity.RankLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="CharacterCommandBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" Margin="0,0,16,0" IsEnabled="False"/>
                    <Button Content="Open Save" Click="Open_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="Save Changes" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="202"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="8,18,8,8">
                        <TextBlock Text="SAVE" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="Bold" Margin="14,0,0,6"/>
                        <RadioButton x:Name="NavOverview" GroupName="Navigation" Tag="Overview" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/overview.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton x:Name="NavCharacter" GroupName="Navigation" Tag="Character" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/overview.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Character Settings" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton GroupName="Navigation" Tag="Items" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/items.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Item Box" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton GroupName="Navigation" Tag="Equipment" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/equipment.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Equipment" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton GroupName="Navigation" Tag="Quests" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/quests.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Guild Quests" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton GroupName="Navigation" Tag="Palicos" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/palico.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Palicos" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <Separator/>
                        <TextBlock Text="TOOLS" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="Bold" Margin="14,0,0,6"/>
                        <RadioButton x:Name="NavCustomQuests" GroupName="Navigation" Tag="CustomQuests" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/quests.png" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Custom Quests" VerticalAlignment="Center"/></StackPanel></RadioButton>
                        <RadioButton GroupName="Navigation" Tag="Advanced" Content="⚙  Backups &amp; Advanced" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Drop a user1 / user2 / user3 file anywhere" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                            <TextBlock Text="Auto backup on save" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,8"/>
                            <Button Content="☼  Toggle light / dark" Click="ToggleTheme_Click" Padding="10,6"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content pages -->
            <Grid Grid.Column="1" Margin="20">
                <views:CustomQuestsView x:Name="CustomQuestsPage" Visibility="Collapsed"/>

                <!-- OVERVIEW -->
                <Grid x:Name="OverviewPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Overview" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,18"/>
                    <ScrollViewer x:Name="OverviewScroll" Grid.Row="1">
                        <Grid x:Name="OverviewSections">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="OverviewCharacterSection" Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Character" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid IsEnabled="{Binding HasCharacter}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                            <TextBlock Text="Name" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <TextBox Text="{Binding Character.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="Hunter Rank" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <TextBox Text="{Binding Character.HunterRank, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                            <TextBlock Text="HR Points" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <TextBox Text="{Binding Character.HunterRankPoints, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                            <TextBlock Text="Funds" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <TextBox Text="{Binding Character.Funds, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OverviewSafetySection" Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Save health" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding ValidationStatus}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding CurrentFilePath}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding BackupSummary}" Margin="0,0,0,12"/>
                                    <Border BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="3,0,0,0" Padding="8,0,0,0" Margin="0,0,0,12">
                                        <TextBlock Text="Relic and Guild Quest combinations may be invalid in-game." FontSize="12"/>
                                    </Border>
                                    <Button HorizontalAlignment="Left" Click="GoBackups_Click" IsEnabled="{Binding HasCharacter}">
                                        <StackPanel Orientation="Horizontal"><Image Source="assets/ui/nav/overview.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Review backups"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OverviewEmulatorSection" Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,16">
                                <StackPanel>
                                    <Grid Height="34" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="EmulatorHeading" Text="Emulator saves" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding EmulatorControlsEnabled}">
                                            <Button Click="RefreshEmulator_Click" Style="{StaticResource IconButtonStyle}" IsEnabled="{Binding CanRefreshEmulator}" ToolTip="Refresh emulator saves" AutomationProperties.Name="Refresh emulator saves" Margin="0,0,8,0"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/></Button>
                                            <Button Click="ClearEmulatorPath_Click" Style="{StaticResource IconButtonStyle}" IsEnabled="{Binding CanRefreshEmulator}" ToolTip="Clear emulator path" AutomationProperties.Name="Clear emulator path"><TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets"/></Button>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel IsEnabled="{Binding EmulatorControlsEnabled}" Margin="0,0,0,10">
                                            <Button Click="DetectEmulator_Click" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" ToolTip="Detect Azahar storage in standard locations">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Detect Azahar"/></StackPanel>
                                            </Button>
                                            <Button Click="SetEmulatorPath_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,5" MinHeight="30" FontSize="12">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Set emulator path" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
                                            </Button>
                                    </WrapPanel>
                                    <ComboBox x:Name="EmulatorLocationPicker" ItemsSource="{Binding EmulatorLocations}" Visibility="Collapsed" SelectionChanged="EmulatorLocation_SelectionChanged" IsEnabled="{Binding EmulatorControlsEnabled}" Margin="0,0,0,8" ToolTip="Detected SDMC storage paths"/>
                                    <TextBlock Text="Active SDMC path" Style="{StaticResource CompactFieldLabelStyle}"/>
                                    <TextBox Text="{Binding EmulatorPathDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" ToolTip="{Binding EmulatorPathDisplay}" FontSize="11" Padding="8,5" MinHeight="30" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding EmulatorStatus}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,0,0,8"/>
                                    <ListBox x:Name="EmulatorSaveRows" ItemsSource="{Binding EmulatorSaves}" SelectionMode="Single" SelectionChanged="EmulatorSaveRows_SelectionChanged"
                                             IsEnabled="{Binding EmulatorControlsEnabled}" MaxHeight="210" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="IsEnabled" Value="{Binding IsReadable}"/>
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="RowHighlight" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                    <Border x:Name="SelectionRail" Background="Transparent"/>
                                                                    <ContentPresenter Grid.Column="1" Margin="8,7" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowHighlight" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="RowHighlight" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                                    <Setter TargetName="RowHighlight" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RowHighlight" Property="Opacity" Value="0.55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border ToolTip="{Binding ToolTip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding GenderSymbol}" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource InfoBrush}" ToolTip="{Binding GenderLabel}" Margin="8,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding RankLabel}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                            <Style.Triggers><DataTrigger Binding="{Binding IsReadable}" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="OverviewRecentSection" Grid.Row="2" Grid.Column="0" Margin="0,18,0,0">
                                <TextBlock Text="Recent saves" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="No recent saves" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding RecentFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="RecentFilesList" ItemsSource="{Binding RecentFiles}" MouseDoubleClick="RecentFilesList_MouseDoubleClick" MinHeight="110" MaxHeight="220" ToolTip="Recent character saves">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Stats}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding PathSnippet}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel x:Name="OverviewActionsSection" Grid.Row="1" Grid.Column="2" Margin="0,16,0,0" IsEnabled="{Binding HasCharacter}">
                                <Grid Height="34" Margin="0,0,0,8"><TextBlock x:Name="QuickActionsHeading" Text="Quick actions" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0"/></Grid>
                                <Button Content="Set every occupied item to 99" Click="SetAllItems99_Click" Margin="0,0,0,8"/>
                                <Button Content="Remove duplicate items &amp; compact" Click="RemoveDupes_Click" Margin="0,0,0,8"/>
                                <Button Content="Reset all unsaved changes" Style="{StaticResource DangerButtonStyle}" Click="ReloadCurrent_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- CHARACTER SETTINGS -->
                <Grid x:Name="CharacterPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Character Settings" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Edit identity and appearance bytes that are normally chosen during character creation." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Identity" Style="{StaticResource SectionTitleStyle}"/>
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Name" Style="{StaticResource CompactFieldLabelStyle}"/><TextBox Text="{Binding Character.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"/></StackPanel>
                                        <StackPanel Margin="4,0,4,8"><TextBlock Text="Gender" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox ItemsSource="{Binding Character.GenderOptions}" SelectedItem="{Binding Character.Gender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Margin="4,0,4,8"><TextBlock Text="Hunter Rank" Style="{StaticResource CompactFieldLabelStyle}"/><TextBox Text="{Binding Character.HunterRank, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                        <StackPanel Margin="8,0,0,8"><TextBlock Text="Funds" Style="{StaticResource CompactFieldLabelStyle}"/><TextBox Text="{Binding Character.Funds, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Gender writes the same save byte represented by the common codes: Male = 0, Female = 1." Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Character-creation choices are shown as friendly 1-based options while the editor writes the correct zero-based save byte underneath." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="Face" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.FaceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.Face, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,8">
                                            <TextBlock Text="Hair Style" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.HairStyleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.HairStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,8">
                                            <TextBlock Text="Voice" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.VoiceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.Voice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="Clothing Type" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.ClothingTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.ClothingType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,4,8">
                                            <TextBlock Text="Eye Color" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.EyeColorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.EyeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,8">
                                            <TextBlock Text="Features / Makeup" Style="{StaticResource CompactFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Character.FeaturesTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Character.FeaturesType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Verified creation-screen counts: 16 faces · 28 hairstyles · 20 voices · 6 clothing types · 10 eye colors · 12 feature styles." Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Appearance Colors" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Click a color square to open the visual picker. The editor converts your choice to the RGB bytes stored by MH4U."
                                               Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,8,0" HorizontalAlignment="Center">
                                            <TextBlock Text="Features" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                            <Button Tag="Feature" Click="CharacterColor_Click" Width="66" Height="66" Padding="6"
                                                    ToolTip="{Binding Character.FeatureColorHex}">
                                                <Border Width="46" Height="46" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        Background="{Binding Character.FeatureColorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                            <TextBlock Text="Hair" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                            <Button Tag="Hair" Click="CharacterColor_Click" Width="66" Height="66" Padding="6"
                                                    ToolTip="{Binding Character.HairColorHex}">
                                                <Border Width="46" Height="46" CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        Background="{Binding Character.HairColorBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                            <TextBlock Text="Clothing" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                            <Button Tag="Clothing" Click="CharacterColor_Click" Width="66" Height="66" Padding="6"
                                                    ToolTip="{Binding Character.ClothingColorHex}">
