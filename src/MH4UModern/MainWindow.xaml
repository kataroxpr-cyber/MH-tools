                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                        <ListBox x:Name="QuestList" ItemsSource="{Binding Quests}" SelectionChanged="QuestList_SelectionChanged" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Slot}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Owner}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource AccentChipStyle}" VerticalAlignment="Center" Margin="12,0,4,0">
                                            <TextBlock Text="Edit ›" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- PALICOS -->
                <Grid x:Name="PalicosPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Palicos" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Main, stringer, and reserve Palicos in one searchable-friendly list." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="PalicoList" Grid.Column="0" ItemsSource="{Binding Palicos}" SelectionChanged="PalicoList_SelectionChanged" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Surface2Brush}"><TextBlock Text="{Binding Slot}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11"><Run Text="EXP  "/><Run Text="{Binding ExpText, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Edit ›" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                            <ScrollViewer><StackPanel>
                                <TextBlock x:Name="PalicoInspectorTitle" Text="Select a Palico" Style="{StaticResource SectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding PalicoFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EditablePropertyViewModel}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel></ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ADVANCED / BACKUPS -->
                <Grid x:Name="AdvancedPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Backups &amp; Advanced" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Recovery tools and the guardrails around dangerous edits." Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Save behavior" Style="{StaticResource SectionTitleStyle}"/>
                                        <CheckBox x:Name="AutoBackupCheck" Content="Create timestamped backup before every save" IsChecked="True"/>
                                        <CheckBox x:Name="PreviewCheck" Content="Show change preview before saving" IsChecked="True" Margin="0,10,0,0"/>
                                        <CheckBox x:Name="ValidationCheck" Content="Warn about suspicious values" IsChecked="True" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Recovery" Style="{StaticResource SectionTitleStyle}"/>
                                        <Button Content="Reset all unsaved changes" Style="{StaticResource DangerButtonStyle}" Click="ReloadCurrent_Click" Margin="0,0,0,8"/>
                                        <Button Content="Open backup folder" Click="OpenBackupFolder_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Backups for this save" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                        <Button Grid.Column="1" Content="Refresh" Click="RefreshBackups_Click"/>
                                    </Grid>
                                    <DataGrid x:Name="BackupsGrid" ItemsSource="{Binding Backups}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MinHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Backup" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Created" Binding="{Binding Date}" Width="210"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="Restore selected backup" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="RestoreBackup_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="Known upstream limitations" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="• Guild Quest editing is experimental in the upstream editor." Margin="0,0,0,6"/>
                                    <TextBlock Text="• Relic-only fields can create invalid equipment if used on normal gear." Margin="0,0,0,6"/>
                                    <TextBlock Text="• Upstream documents a waist armor ID mismatch at some point in the list."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Centered single-click editors. Hidden while arranging. -->
        <Grid x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100" Background="#B50A0D12">
            <Border VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
                <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="930"/><Setter Property="MaxWidth" Value="930"/><Setter Property="MaxHeight" Value="690"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=CustomQuestOverlayHost}" Value="Visible"><Setter Property="Width" Value="Auto"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MaxWidth" Value="1200"/><Setter Property="MaxHeight" Value="820"/><Setter Property="Margin" Value="20"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.45"/></Border.Effect>
                <Grid>
                    <!-- Item editor -->
                    <Grid x:Name="ItemEditorOverlayPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="16,16,0,0" Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" Background="{DynamicResource IconSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                    <Grid><Image x:Name="SelectedItemImage" Margin="5" Stretch="Uniform"/><TextBlock x:Name="SelectedItemIconGlyph" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedItemTitle" Text="Item" FontSize="21" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Style="{StaticResource AccentChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="SelectedItemCategoryChip" Text="Item" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <Border Style="{StaticResource ChipStyle}"><TextBlock x:Name="SelectedItemSlotChip" Text="Slot" FontSize="10"/></Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" Click="CloseEditorOverlay_Click" ToolTip="Close"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Item" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="SelectedItemIdCombo" ItemsSource="{Binding ItemNames}" SelectionChanged="SelectedItemIdCombo_SelectionChanged" IsTextSearchEnabled="True"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Quantity" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="SelectedItemCountBox" LostFocus="SelectedItemCountBox_LostFocus"/></StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="4,12,4,0">
                                <TextBlock x:Name="SelectedItemSubtitle" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                                <Border x:Name="SelectedItemCatalogCard" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,9,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedItemCatalogLine" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="SelectedItemCatalogDescription" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Edits stay unsaved until you press Save Changes." Style="{StaticResource MutedTextStyle}" FontSize="10" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Set 99" Style="{StaticResource CompactButtonStyle}" Click="SetSelectedItems99_Click" Margin="0,0,7,0"/><Button Content="Clear slot" Style="{StaticResource DangerButtonStyle}" Click="ClearSelectedItems_Click" Margin="0,0,7,0"/><Button Content="Done" Style="{StaticResource AccentButtonStyle}" Click="CloseEditorOverlay_Click"/></StackPanel></Grid>
                        </Border>
                    </Grid>

                    <!-- Equipment editor -->
                    <Grid x:Name="EquipmentEditorOverlayPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="16,16,0,0" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" Background="{DynamicResource IconSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11"><Image x:Name="SelectedEquipmentImage" Stretch="Uniform" Margin="5"/></Border>
                                <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedEquipmentTitle" Text="Equipment" FontSize="21" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Style="{StaticResource AccentChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="SelectedEquipmentTypeChip" Text="Equipment" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="SelectedEquipmentSlotChip" Text="Slot" FontSize="10"/></Border>
                                        <Border Style="{StaticResource ChipStyle}"><TextBlock x:Name="SelectedEquipmentRarityChip" Text="Rarity" FontSize="10" Foreground="{DynamicResource WarningBrush}"/></Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" Click="CloseEditorOverlay_Click" ToolTip="Close"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14,20,12">
                            <StackPanel>
                                <!-- Icon-first equipment type picker. No long text dropdown. -->
                                <Border x:Name="EquipmentTypePickerCard" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,7"><TextBlock Text="TYPE" Style="{StaticResource MutedTextStyle}" FontSize="9" FontWeight="Bold"/><TextBlock HorizontalAlignment="Right" Text="Pick a category" Style="{StaticResource MutedTextStyle}" FontSize="9"/></Grid>
                                        <UniformGrid x:Name="EquipmentTypeIconGrid" Columns="10">
                                            <ToggleButton Tag="1" ToolTip="Chest" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Chest.png"/><TextBlock Text="Chest"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="2" ToolTip="Arms" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Arms.png"/><TextBlock Text="Arms"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="3" ToolTip="Waist" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Waist.png"/><TextBlock Text="Waist"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="4" ToolTip="Legs" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Legs.png"/><TextBlock Text="Legs"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="5" ToolTip="Head" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Head.png"/><TextBlock Text="Head"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="6" ToolTip="Talisman" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Talisman.png"/><TextBlock Text="Talisman"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="7" ToolTip="Great Sword" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Greatsword.png"/><TextBlock Text="GS"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="8" ToolTip="Sword and Shield" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_SwordAndShield.png"/><TextBlock Text="SnS"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="9" ToolTip="Hammer" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Hammer.png"/><TextBlock Text="Hammer"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="10" ToolTip="Lance" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Lance.png"/><TextBlock Text="Lance"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="11" ToolTip="Light Bowgun" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_LightBowgun.png"/><TextBlock Text="LBG"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="12" ToolTip="Heavy Bowgun" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_HeavyBowgun.png"/><TextBlock Text="HBG"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="13" ToolTip="Longsword" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Longsword.png"/><TextBlock Text="LS"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="14" ToolTip="Switch Axe" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Switchaxe.png"/><TextBlock Text="SA"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="15" ToolTip="Gunlance" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Gunlance.png"/><TextBlock Text="GL"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="16" ToolTip="Bow" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Bow.png"/><TextBlock Text="Bow"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="17" ToolTip="Dual Blades" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_Dualblades.png"/><TextBlock Text="DB"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="18" ToolTip="Hunting Horn" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_HuntingHorn.png"/><TextBlock Text="HH"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="19" ToolTip="Insect Glaive" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_InsectGlaive.png"/><TextBlock Text="IG"/></StackPanel></ToggleButton>
                                            <ToggleButton Tag="20" ToolTip="Charge Blade" Style="{StaticResource EquipmentTypeTileStyle}" Click="EquipmentTypeIcon_Click"><StackPanel><Image Source="images/Equip_ChargeBlade.png"/><TextBlock Text="CB"/></StackPanel></ToggleButton>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Padding="11" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="EQUIPMENT" Style="{StaticResource MutedTextStyle}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button x:Name="EquipmentTypePickerButton" Grid.Column="1" HorizontalAlignment="Right" Content="Type: Equipment  ▾" Style="{StaticResource CompactButtonStyle}" Padding="9,4" Click="EquipmentTypePickerButton_Click"/>
                                            </Grid>
                                            <ComboBox x:Name="EquipmentIdCombo" DisplayMemberPath="IDString" SelectedValuePath="ID" SelectionChanged="EquipmentIdCombo_SelectionChanged" IsTextSearchEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                            <Button Content="Copy" Style="{StaticResource CompactButtonStyle}" Click="CopyEquipment_Click" Margin="0,0,5,0"/>
                                            <Button Content="Paste" Style="{StaticResource CompactButtonStyle}" Click="PasteEquipment_Click" Margin="0,0,5,0"/>
                                            <Button Content="Duplicate" Style="{StaticResource CompactButtonStyle}" Click="DuplicateEquipment_Click" Margin="0,0,5,0"/>
                                            <Button Content="Clear" Style="{StaticResource DangerButtonStyle}" Click="ClearEquipment_Click" Padding="10,5" MinHeight="30"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Weapon editor -->
                                <StackPanel x:Name="WeaponEditorPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="DECORATIONS" Style="{StaticResource EditorSectionHeaderStyle}"/>
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Slot 1" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="WeaponSlot1Combo" Tag="Slot1" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="WeaponSlot1FixedCheck" Tag="Slot1Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" ToolTip="Fixed decoration" Margin="7,0,0,0"/></Grid></StackPanel>
                                                <StackPanel Margin="4,0"><TextBlock Text="Slot 2" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="WeaponSlot2Combo" Tag="Slot2" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="WeaponSlot2FixedCheck" Tag="Slot2Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" ToolTip="Fixed decoration" Margin="7,0,0,0"/></Grid></StackPanel>
                                                <StackPanel Margin="8,0,0,0"><TextBlock Text="Slot 3" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="WeaponSlot3Combo" Tag="Slot3" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="WeaponSlot3FixedCheck" Tag="Slot3Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" ToolTip="Fixed decoration" Margin="7,0,0,0"/></Grid></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="NormalWeaponHoningSection" Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="NORMAL WEAPON" Style="{StaticResource EditorSectionHeaderStyle}"/>
                                                <TextBlock Text="Crafted weapons expose only decoration slots and the normal honing value. Relic-only bytes stay hidden." Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,3,16,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Honing" Style="{StaticResource CompactFieldLabelStyle}"/>
                                                <ComboBox x:Name="NormalWeaponHoningCombo" Tag="Honing" SelectionChanged="EquipmentValueCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="WeaponStatsSection" Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="WeaponStatsHeader" Text="STATS" Style="{StaticResource EditorSectionHeaderStyle}"/>
                                            <UniformGrid x:Name="WeaponStatsGrid" Columns="5">
                                                <StackPanel x:Name="WeaponElementTypeField" Margin="0,0,7,0"><TextBlock Text="Element" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponElementTypeCombo" Tag="ElementType" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel x:Name="WeaponElementValueField" Margin="2,0,5,0"><TextBlock Text="Element Attack" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponElementValueCombo" Tag="ElementValue" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel x:Name="WeaponSharpnessField" Margin="4,0"><TextBlock x:Name="WeaponSharpnessLabel" Text="Sharpness" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponSharpnessCombo" Tag="Sharpness" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel x:Name="WeaponHoningField" Margin="5,0,2,0"><TextBlock Text="Honing" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponHoningCombo" Tag="Honing" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel x:Name="WeaponModifierField" Margin="7,0,0,0"><TextBlock Text="Modifier" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponModifierCombo" Tag="Modifier" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            </UniformGrid>
                                            <StackPanel x:Name="LegacyWeaponTools" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed"><Button x:Name="LegacyPatternButton" Content="Visual pattern…" Style="{StaticResource CompactButtonStyle}" Click="LegacyPattern_Click" Margin="0,0,6,0"/><Button x:Name="LegacySpecialButton" Content="Special pattern…" Style="{StaticResource CompactButtonStyle}" Click="LegacySpecial_Click"/></StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="WeaponMiscSection" Style="{StaticResource EditorSectionStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MISCELLANEOUS" Style="{StaticResource EditorSectionHeaderStyle}" Margin="0"/><TextBlock x:Name="WeaponRarityHint" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontSize="9"/></Grid>
                                            <UniformGrid Columns="4">
                                                <StackPanel Margin="0,0,7,6"><TextBlock Text="Upgrade" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponUpgradeCombo" Tag="Upgrade" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel Margin="3,0,4,6"><TextBlock x:Name="WeaponSpecialLabel" Text="Special" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponSpecialCombo" Tag="Special" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel x:Name="WeaponKinsectField" Margin="4,0,3,6"><TextBlock Text="Kinsect Level" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponKinsectLevelCombo" Tag="KinsectLevel" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel Margin="7,0,0,6"><TextBlock Text="Relic Slots" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponNumSlotsCombo" Tag="NumSlots" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Rarity" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponRarityCombo" Tag="Rarity" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel Margin="3,0,4,0"><TextBlock Text="Polish Requirement" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="WeaponPolishReqCombo" Tag="PolishReq" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                                <StackPanel Margin="4,0,3,0"><TextBlock Text="Relic State" Style="{StaticResource CompactFieldLabelStyle}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><CheckBox x:Name="WeaponPolishedCheck" Tag="Polished" Content="Polished" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed"/><CheckBox x:Name="WeaponGlowCheck" Tag="Glow" Content="Glow" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed"/></StackPanel></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Armor editor -->
                                <StackPanel x:Name="ArmorEditorPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10">
                                        <StackPanel><TextBlock Text="DECORATIONS" Style="{StaticResource EditorSectionHeaderStyle}"/><UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Slot 1" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ArmorSlot1Combo" Tag="Slot1" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="ArmorSlot1FixedCheck" Tag="Slot1Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" Margin="7,0,0,0" ToolTip="Fixed decoration"/></Grid></StackPanel>
                                            <StackPanel Margin="4,0"><TextBlock Text="Slot 2" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ArmorSlot2Combo" Tag="Slot2" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="ArmorSlot2FixedCheck" Tag="Slot2Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" Margin="7,0,0,0" ToolTip="Fixed decoration"/></Grid></StackPanel>
                                            <StackPanel Margin="8,0,0,0"><TextBlock Text="Slot 3" Style="{StaticResource CompactFieldLabelStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ArmorSlot3Combo" Tag="Slot3" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/><CheckBox x:Name="ArmorSlot3FixedCheck" Tag="Slot3Fixed" Grid.Column="1" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed" Margin="7,0,0,0" ToolTip="Fixed decoration"/></Grid></StackPanel>
                                        </UniformGrid></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EditorSectionStyle}">
                                        <StackPanel><TextBlock Text="ARMOR VALUES" Style="{StaticResource EditorSectionHeaderStyle}"/><UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,7,6"><TextBlock Text="Upgrade" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorUpgradeCombo" Tag="Upgrade" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="3,0,4,6"><TextBlock Text="Resistances" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorResistancesCombo" Tag="Resistances" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="4,0,3,6"><TextBlock Text="Defense" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorDefenseCombo" Tag="Defense" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="7,0,0,6"><TextBlock Text="Relic Slots" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorNumSlotsCombo" Tag="NumSlots" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="0,0,7,0"><TextBlock Text="Rarity" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorRarityCombo" Tag="Rarity" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="3,0,4,0"><TextBlock Text="Polish Requirement" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="ArmorPolishReqCombo" Tag="PolishReq" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="4,0,3,0"><TextBlock Text="Relic State" Style="{StaticResource CompactFieldLabelStyle}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><CheckBox x:Name="ArmorPolishedCheck" Tag="Polished" Content="Polished" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed"/><CheckBox x:Name="ArmorGlowCheck" Tag="Glow" Content="Glow" Checked="EquipmentValueCheck_Changed" Unchecked="EquipmentValueCheck_Changed"/></StackPanel></StackPanel>
                                        </UniformGrid><TextBlock x:Name="ArmorRarityHint" Style="{StaticResource MutedTextStyle}" FontSize="9" Margin="0,8,0,0"/></StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Talisman editor -->
                                <StackPanel x:Name="TalismanEditorPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource EditorSectionStyle}" Margin="0,0,0,10">
                                        <StackPanel><TextBlock Text="DECORATIONS" Style="{StaticResource EditorSectionHeaderStyle}"/><UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Slot 1" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSlot1Combo" Tag="Slot0" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/></StackPanel>
                                            <StackPanel Margin="4,0"><TextBlock Text="Slot 2" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSlot2Combo" Tag="Slot1" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/></StackPanel>
                                            <StackPanel Margin="8,0,0,0"><TextBlock Text="Slot 3" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSlot3Combo" Tag="Slot2" SelectionChanged="EquipmentValueCombo_SelectionChanged" DropDownOpened="DecorationCombo_DropDownOpened"/></StackPanel>
                                        </UniformGrid></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EditorSectionStyle}">
                                        <StackPanel><TextBlock Text="TALISMAN VALUES" Style="{StaticResource EditorSectionHeaderStyle}"/><UniformGrid Columns="5">
                                            <StackPanel Margin="0,0,7,0"><TextBlock Text="Slots" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanNumSlotsCombo" Tag="NumSlots" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="2,0,5,0"><TextBlock Text="Skill 1" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSkill1Combo" Tag="Skill1ID" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="4,0"><TextBlock Text="Amount" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSkill1AmountCombo" Tag="Skill1Amount" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="5,0,2,0"><TextBlock Text="Skill 2" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSkill2Combo" Tag="Skill2ID" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Margin="7,0,0,0"><TextBlock Text="Amount" Style="{StaticResource CompactFieldLabelStyle}"/><ComboBox x:Name="TalismanSkill2AmountCombo" Tag="Skill2Amount" SelectionChanged="EquipmentValueCombo_SelectionChanged"/></StackPanel>
                                        </UniformGrid></StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border x:Name="EmptyEquipmentEditorPanel" Style="{StaticResource EditorSectionStyle}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,14"><TextBlock Text="Choose an equipment type above" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Then choose the equipment ID. All compatible dropdown values will load automatically." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedEquipmentSubtitle" Style="{StaticResource MutedTextStyle}" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="CloseEditorOverlay_Click"/></Grid>
                        </Border>
                    </Grid>

                    <!-- Guild Quest editor -->
                    <Grid x:Name="QuestEditorOverlayPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" CornerRadius="16,16,0,0" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" Background="{DynamicResource IconSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                    <Image Source="assets/ui/nav/quests.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuestInspectorTitle" Text="Guild Quest" FontSize="21" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Style="{StaticResource AccentChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="QuestSlotChip" Text="Quest" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="QuestLevelChip" Text="Level" FontSize="10"/></Border>
                                        <Border Style="{StaticResource ChipStyle}"><TextBlock x:Name="QuestOwnerChip" Text="Owner" FontSize="10"/></Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButtonStyle}" Width="38" Height="38" Click="CloseEditorOverlay_Click" ToolTip="Close"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14,20,12">
                            <StackPanel>
                                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,12">
                                    <TextBlock Text="Edit existing active quests only. Keep Monster 2 empty unless that quest already had a second monster; invalid combinations may be rejected by MH4U." Foreground="{DynamicResource WarningBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                                </Border>
                                <Border Style="{StaticResource EditorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="QUEST DATA" Style="{StaticResource EditorSectionHeaderStyle}"/>
                                        <ItemsControl ItemsSource="{Binding QuestFields}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EditablePropertyViewModel}">
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CompactFieldLabelStyle}"/>
                                                        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Help}" Style="{StaticResource MutedTextStyle}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="9" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Quest edits stay unsaved until you press Save Changes." Style="{StaticResource MutedTextStyle}" FontSize="10" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="CloseEditorOverlay_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ContentControl x:Name="CustomQuestOverlayHost" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource MutedTextBrush}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Text="Open or drop an MH4U user save to begin." Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Core: mh4edit 1.0.2 · UI: Modern 0.18.0" Style="{StaticResource MutedTextStyle}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
