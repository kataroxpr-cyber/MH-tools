                                                    <Image Source="{Binding IconImage}" Width="24" Height="24" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Style="{StaticResource MutedTextStyle}" FontSize="10"/></StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource ChipStyle}" VerticalAlignment="Center" Margin="10,0,2,0"><TextBlock Text="{Binding Slot, StringFormat=Slot {0}}" FontSize="10"/></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <ToggleButton Grid.Column="4" x:Name="ItemArrangeButton" Content="⇄  Arrange" Style="{StaticResource CompactToggleButtonStyle}" Checked="ItemArrange_Changed" Unchecked="ItemArrange_Changed" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
