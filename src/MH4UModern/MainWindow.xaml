                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EquipmentSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Popup x:Name="EquipmentSearchPopup" PlacementTarget="{Binding ElementName=EquipmentSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Width="580" MaxHeight="260">
                                    <ListBox x:Name="EquipmentSearchSuggestionsList" ItemsSource="{Binding EquipmentSearchSuggestions}" SelectionChanged="EquipmentSearchSuggestionsList_SelectionChanged">
                                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding Image}" Width="28" Height="28" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Style="{StaticResource MutedTextStyle}" FontSize="10"/></StackPanel><Border Grid.Column="2" Style="{StaticResource ChipStyle}" VerticalAlignment="Center" Margin="10,0,2,0"><TextBlock Text="{Binding Slot, StringFormat=Slot {0}}" FontSize="10"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="EquipmentSortButton" Content="Sort  ▾" Style="{StaticResource CompactButtonStyle}" Click="EquipmentSortButton_Click" Margin="0,0,7,0" ToolTip="Rearrange the physical equipment box using a saved layout"/>
                            <ToggleButton x:Name="EquipmentArrangeButton" Content="⇄  Arrange" Style="{StaticResource CompactToggleButtonStyle}" Checked="EquipmentArrange_Changed" Unchecked="EquipmentArrange_Changed"/>
                        </StackPanel>
                        <Popup x:Name="EquipmentSortPopup" PlacementTarget="{Binding ElementName=EquipmentSortButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="7" Width="310">
                                <StackPanel>
                                    <Button Style="{StaticResource CompactButtonStyle}" Click="SortEquipmentMonsterSets_Click" HorizontalContentAlignment="Left" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Monster Sets" FontWeight="SemiBold"/>
                                            <TextBlock Text="Vertical 5-piece sets by rarity/catalog order; weapons then talismans." Style="{StaticResource MutedTextStyle}" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="More sort layouts can be added here later." Style="{StaticResource MutedTextStyle}" FontSize="9" Margin="5,7,5,2"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

