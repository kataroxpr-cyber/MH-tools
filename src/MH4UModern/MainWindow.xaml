                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ItemGapColumn" Width="0"/>
                            <ColumnDefinition x:Name="ItemRightColumn" Width="0"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="3,0,3,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="BOX" Style="{StaticResource MutedTextStyle}" FontSize="9" FontWeight="Bold" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="ItemLeftBoxKind" Text="Items" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="‹" Style="{StaticResource IconButtonStyle}" Click="ItemPagePrevious_Click" Tag="Left" Margin="0,0,5,0"/>
                                        <Button x:Name="ItemPagePickerButton" Click="ItemPagePicker_Click" Tag="Left" Style="{StaticResource CompactButtonStyle}" MinWidth="82"><TextBlock x:Name="ItemPageLabel" Text="1 / 14" FontWeight="SemiBold"/></Button>
                                        <Button Content="›" Style="{StaticResource IconButtonStyle}" Click="ItemPageNext_Click" Tag="Left" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ItemsGrid" Grid.Row="1" ItemsSource="{Binding ItemPageSlots}" SelectionMode="Single" Style="{StaticResource InventoryGridListBoxStyle}" ItemContainerStyle="{StaticResource SlotListBoxItemStyle}" ItemTemplate="{StaticResource ItemSlotTemplate}" SelectionChanged="ItemsGrid_SelectionChanged" PreviewMouseLeftButtonDown="ItemsGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="ItemsGrid_PreviewMouseMove" AllowDrop="True" DragOver="ItemsGrid_DragOver" Drop="ItemsGrid_Drop">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="10" Columns="10"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="ItemRightCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="7" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="3,0,3,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TARGET" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="ItemRightBoxKind" Text="Items" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="‹" Style="{StaticResource IconButtonStyle}" Click="ItemRightPagePrevious_Click" Margin="0,0,5,0"/>
                                        <Button x:Name="ItemRightPagePickerButton" Click="ItemPagePicker_Click" Tag="Right" Style="{StaticResource CompactButtonStyle}" MinWidth="82"><TextBlock x:Name="ItemRightPageLabel" Text="2 / 14" FontWeight="SemiBold"/></Button>
                                        <Button Content="›" Style="{StaticResource IconButtonStyle}" Click="ItemRightPageNext_Click" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ItemsGridRight" Grid.Row="1" ItemsSource="{Binding ItemRightPageSlots}" SelectionMode="Extended" Style="{StaticResource InventoryGridListBoxStyle}" ItemContainerStyle="{StaticResource SlotListBoxItemStyle}" ItemTemplate="{StaticResource ItemSlotTemplate}" SelectionChanged="ItemsGrid_SelectionChanged" PreviewMouseLeftButtonDown="ItemsGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="ItemsGrid_PreviewMouseMove" AllowDrop="True" DragOver="ItemsGrid_DragOver" Drop="ItemsGrid_Drop">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="10" Columns="10"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Popup x:Name="ItemPagePickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
