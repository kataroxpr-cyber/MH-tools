                                                <DataTrigger Binding="{Binding HasIcon}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsOccupied}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding IconGlyph}" FontSize="22" Foreground="{Binding IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.96">
