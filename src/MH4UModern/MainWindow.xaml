                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ItemSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Popup x:Name="ItemSearchPopup" PlacementTarget="{Binding ElementName=ItemSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
