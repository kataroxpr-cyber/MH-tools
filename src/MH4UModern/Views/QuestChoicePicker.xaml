<UserControl x:Class="MH4UModern.Views.QuestChoicePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16">
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleLabel" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" ToolTip="Cancel selection" Click="Close_Click"/>
        </Grid>
        <TextBox x:Name="QueryBox" Grid.Row="1" Style="{StaticResource SearchBoxStyle}" TextChanged="Query_Changed" ToolTip="Search by name or ID" Margin="0,0,0,12"/>
        <Grid Grid.Row="2">
            <ListBox x:Name="ChoiceRows" ItemContainerStyle="{StaticResource SlotListBoxItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" MouseLeftButtonUp="Choice_Click" KeyDown="Choice_KeyDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Width="108" Height="110" Margin="2" ToolTip="{Binding Detail}">
                        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                        <Image Source="{Binding Icon}" Width="76" Height="54" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="5,0,5,4" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLabel" Text="No matches" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CountLabel" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PreviousButton" FontFamily="Segoe MDL2 Assets" Content="&#xE76B;" Style="{StaticResource IconButtonStyle}" ToolTip="Previous page" Click="Previous_Click"/>
                <TextBlock x:Name="PageLabel" Width="70" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                <Button x:Name="NextButton" FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" Style="{StaticResource IconButtonStyle}" ToolTip="Next page" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</UserControl>
