<UserControl x:Class="MH4UModern.Views.QuestItemBoxEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MH4UModern.Views"
             xmlns:vm="clr-namespace:MH4UModern.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,0">
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="GroupPicker" ItemsSource="{Binding Groups, ElementName=Root}" DisplayMemberPath="Name" SelectionChanged="Group_Changed" ToolTip="{Binding GroupLabel, ElementName=Root}"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding CountText, ElementName=Root}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE76B;" Style="{StaticResource IconButtonStyle}" ToolTip="Previous page" Click="Previous_Click" IsEnabled="{Binding HasPrevious, ElementName=Root}" Visibility="{Binding PagingVisibility, ElementName=Root}" Margin="0,0,6,0"/>
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" Style="{StaticResource IconButtonStyle}" ToolTip="Next page" Click="Next_Click" IsEnabled="{Binding HasNext, ElementName=Root}" Visibility="{Binding PagingVisibility, ElementName=Root}" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding StructuralVisibility, ElementName=Root}"><Button FontFamily="Segoe MDL2 Assets" Content="&#xE710;" Style="{StaticResource IconButtonStyle}" ToolTip="Add item" Click="Add_Click" IsEnabled="{Binding CanAdd, ElementName=Root}" Margin="0,0,6,0"/>
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Style="{StaticResource IconButtonStyle}" ToolTip="Duplicate selected item" Click="Duplicate_Click" IsEnabled="{Binding CanDuplicate, ElementName=Root}" Margin="0,0,6,0"/>
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Style="{StaticResource IconButtonStyle}" ToolTip="Remove selected item" Click="Remove_Click" IsEnabled="{Binding HasSelection, ElementName=Root}"/>
                    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE75C;" Style="{StaticResource IconButtonStyle}" ToolTip="Clear all boxes" Click="Clear_Click" Margin="6,0,0,0"/></StackPanel>
                </StackPanel>
            </Grid>
            <ListBox x:Name="SlotRows" Height="220" ItemsSource="{Binding Slots, ElementName=Root}" Style="{StaticResource InventoryGridListBoxStyle}" ItemContainerStyle="{StaticResource SlotListBoxItemStyle}" SelectionChanged="Slot_Selected" PreviewMouseLeftButtonUp="Slot_Click" PreviewKeyDown="Slot_KeyDown">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="5" Columns="8"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid ToolTip="{Binding Tooltip}">
                        <Image Source="{Binding IconImage}" Width="24" Height="24" Margin="4,5,4,8" Stretch="Uniform"/>
                        <TextBlock Text="{Binding Slot}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="5,2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Quantity}" FontSize="9" FontWeight="SemiBold" Margin="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding Chance}" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" Margin="4,1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="EntryDetails" Margin="0,4,0,0" Visibility="{Binding DetailVisibility, ElementName=Root}" DataContext="{Binding SelectedEntry, ElementName=Root}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <Button Click="ChangeItem_Click" Padding="8,4" HorizontalContentAlignment="Stretch" ToolTip="Choose item">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <Image Source="{Binding IconImage}" Width="24" Height="24"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="Quantity" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/><views:CreationFieldInput DataContext="{Binding Quantity}"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding GroupLabel, ElementName=Root}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <StackPanel Visibility="{Binding StructuralVisibility, ElementName=Root}"><views:CreationFieldInput DataContext="{Binding Box}" Visibility="{Binding SupplyVisibility, ElementName=Root}"/>
                    <ComboBox ItemsSource="{x:Static vm:QuestCreationChoices.RewardTables}" SelectedItem="{Binding Table}" DisplayMemberPath="Name" Visibility="{Binding RewardVisibility, ElementName=Root}"/></StackPanel>
                    <TextBlock Text="{Binding LocationLabel}" Visibility="{Binding LockedVisibility, ElementName=Root}" Height="36" VerticalAlignment="Center" Padding="8"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Visibility="{Binding RewardVisibility, ElementName=Root}"><TextBlock Text="Chance %" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/><views:CreationFieldInput DataContext="{Binding Chance}"/></StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
