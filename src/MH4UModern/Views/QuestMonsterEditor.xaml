<UserControl x:Class="MH4UModern.Views.QuestMonsterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MH4UModern.Views"
             xmlns:vm="clr-namespace:MH4UModern.ViewModels"
             Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
    <Grid><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16">
        <Grid Margin="24,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="MonsterChoice" Click="Choose_Click" ToolTip="Choose monster" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal"><Image Source="{Binding Monster.Icon}" Width="48" Height="48" Margin="0,0,12,0"/><TextBlock Text="{Binding Monster.Name}" FontSize="18" VerticalAlignment="Center"/><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                </Button>
                <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:QuestCreationChoices.MonsterKinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Name" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Monster type"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsLayoutLocked}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                <Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" Click="Cancel_Click" ToolTip="Cancel monster changes" VerticalAlignment="Top"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Fields" ItemsSource="{Binding Numbers}" Height="{Binding FieldHeight}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,16,10"><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/><views:CreationFieldInput ChoiceOpened="Spawn_Opened" ChoiceClosed="Spawn_Closed"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" MaxHeight="60"/><Button x:Name="RemoveButton" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Style="{StaticResource IconButtonStyle}" ToolTip="Remove this monster" Click="Remove_Click" HorizontalAlignment="Left"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"/><Button Content="Done" Click="Done_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
            </Grid>
        </Grid>
    </Border><views:QuestMapPreview x:Name="MapPreview"/></Grid>
</UserControl>
