<UserControl x:Class="MH4UModern.Views.QuestMapPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Popup x:Name="MapPopup" Placement="Right" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False">
        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0">
            <StackPanel Width="300"><TextBlock x:Name="MapTitle" FontWeight="SemiBold" Margin="0,0,0,10"/><Image x:Name="MapImage" Width="300" Height="290" Stretch="Uniform"/><TextBlock x:Name="MapAreas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Border>
    </Popup>
</UserControl>
