<UserControl x:Class="MH4UModern.Views.CreationFieldInput" IsEnabled="{Binding IsEnabled}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="36">
    <Grid>
        <Grid Visibility="{Binding NumberVisibility}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
            <Button FontFamily="Segoe MDL2 Assets" Content="&#xE738;" Width="26" MinWidth="26" Padding="0" ToolTip="Decrease value" Click="Decrease_Click"/>
            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="{Binding Hint}" Margin="3,0" Padding="4,7"/>
            <Button Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE710;" Width="26" MinWidth="26" Padding="0" ToolTip="Increase value" Click="Increase_Click"/>
        </Grid>
        <ComboBox x:Name="ChoiceInput" Visibility="{Binding ChoiceVisibility}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                  Padding="9,5,28,5" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="280" ToolTip="{Binding SelectedChoice.Detail}" DropDownOpened="Choice_Opened" DropDownClosed="Choice_Closed">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Visibility="{Binding ToggleVisibility}" Content="Enabled" IsChecked="{Binding ToggleValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
