<Window x:Class="MH4UModern.ChangePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Changes"
        Width="760" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review changes" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Review these edits before the original save is overwritten." Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>

        <Border x:Name="WarningsPanel" Grid.Row="1" Background="#2D2616" BorderBrush="#594A22" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Validation warnings" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,2"><Run Text="• "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="130"/>
                    <DataGridTextColumn Header="Change" Binding="{Binding Display}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Save only if these edits are expected." Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Save changes" Width="140" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
